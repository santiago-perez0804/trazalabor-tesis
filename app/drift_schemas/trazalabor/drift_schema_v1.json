  "fixed_sql": [
    {
      "name": "usuario",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"usuario\" (\"id\" TEXT NOT NULL, \"auth_id\" TEXT NULL, \"nombre\" TEXT NOT NULL, \"telefono\" TEXT NOT NULL UNIQUE, \"rol\" TEXT NOT NULL CHECK(\"rol\" IN ('ENCARGADO', 'TRABAJADOR')), \"especialidad\" TEXT NULL, \"activo\" INTEGER NOT NULL DEFAULT 1 CHECK (\"activo\" IN (0, 1)), \"created_at_device\" TEXT NOT NULL, \"received_at_server\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "unidad_productiva",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"unidad_productiva\" (\"id\" TEXT NOT NULL, \"nombre\" TEXT NOT NULL, \"tipo\" TEXT NOT NULL CHECK(\"tipo\" IN ('LOTE', 'POTRERO', 'INSTALACION')), \"superficie_ha\" REAL NULL, \"codigo_qr\" TEXT NOT NULL UNIQUE, \"latitud\" REAL NULL, \"longitud\" REAL NULL, \"activa\" INTEGER NOT NULL DEFAULT 1 CHECK (\"activa\" IN (0, 1)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "tarea",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"tarea\" (\"id\" TEXT NOT NULL, \"unidad_productiva_id\" TEXT NOT NULL REFERENCES unidad_productiva (id), \"creador_id\" TEXT NOT NULL REFERENCES usuario (id), \"asignado_id\" TEXT NOT NULL REFERENCES usuario (id), \"tipo_labor\" TEXT NOT NULL CHECK(\"tipo_labor\" IN ('GENERAL', 'SIEMBRA', 'APLICACION_FITOSANITARIA', 'SANIDAD_ANIMAL', 'MANTENIMIENTO')), \"descripcion\" TEXT NULL, \"fecha_programada\" TEXT NOT NULL, \"requiere_qr\" INTEGER NOT NULL DEFAULT 0 CHECK (\"requiere_qr\" IN (0, 1)), \"evidencia_requerida\" TEXT NOT NULL DEFAULT 'NINGUNA' CHECK(\"evidencia_requerida\" IN ('NINGUNA', 'FOTO', 'AUDIO', 'FOTO_Y_AUDIO')), \"estado_actual\" TEXT NOT NULL DEFAULT 'CREADA' CHECK(\"estado_actual\" IN ('CREADA', 'ASIGNADA', 'INICIADA', 'COMPLETADA', 'NO_COMPLETADA', 'VERIFICADA')), \"created_at_device\" TEXT NOT NULL, \"received_at_server\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "item_checklist",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"item_checklist\" (\"id\" TEXT NOT NULL, \"tarea_id\" TEXT NOT NULL REFERENCES tarea (id), \"orden\" INTEGER NOT NULL, \"descripcion\" TEXT NOT NULL, \"tipo_respuesta\" TEXT NOT NULL CHECK(\"tipo_respuesta\" IN ('CHECK', 'NUMERO', 'TEXTO')), \"obligatorio\" INTEGER NOT NULL DEFAULT 0 CHECK (\"obligatorio\" IN (0, 1)), \"valor\" TEXT NULL, \"completado\" INTEGER NOT NULL DEFAULT 0 CHECK (\"completado\" IN (0, 1)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "evento",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"evento\" (\"id\" TEXT NOT NULL, \"tarea_id\" TEXT NOT NULL REFERENCES tarea (id), \"usuario_id\" TEXT NOT NULL REFERENCES usuario (id), \"tipo\" TEXT NOT NULL CHECK(\"tipo\" IN ('CREADA', 'ASIGNADA', 'INICIADA', 'ITEM_COMPLETADO', 'QR_VERIFICADO', 'EVIDENCIA_ADJUNTA', 'COMPLETADA', 'NO_COMPLETADA', 'VERIFICADA', 'REASIGNADA')), \"payload\" TEXT NOT NULL DEFAULT '{}', \"created_at_device\" TEXT NOT NULL, \"received_at_server\" TEXT NULL, \"latitud\" REAL NULL, \"longitud\" REAL NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "evidencia",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"evidencia\" (\"id\" TEXT NOT NULL, \"tarea_id\" TEXT NOT NULL REFERENCES tarea (id), \"usuario_id\" TEXT NOT NULL REFERENCES usuario (id), \"tipo\" TEXT NOT NULL CHECK(\"tipo\" IN ('FOTO', 'AUDIO')), \"ruta_local\" TEXT NULL, \"ruta_remota\" TEXT NULL, \"tamanio_bytes\" INTEGER NULL, \"hash_sha256\" TEXT NOT NULL, \"created_at_device\" TEXT NOT NULL, \"received_at_server\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "operacion_pendiente",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"operacion_pendiente\" (\"id\" TEXT NOT NULL, \"entidad\" TEXT NOT NULL, \"entidad_id\" TEXT NOT NULL, \"operacion\" TEXT NOT NULL CHECK(\"operacion\" IN ('INSERT', 'UPDATE', 'SUBIDA')), \"payload\" TEXT NOT NULL, \"intentos\" INTEGER NOT NULL DEFAULT 0, \"ultimo_error\" TEXT NULL, \"created_at_device\" TEXT NOT NULL, \"estado\" TEXT NOT NULL DEFAULT 'PENDIENTE' CHECK(\"estado\" IN ('PENDIENTE', 'ENVIADO', 'ERROR')), PRIMARY KEY (\"id\"));"
        }
      ]
